{
  "name": "fraguio-blog",
  "version": "1.0.0",
  "description": "Blog personal minimalista con Node.js, Express, React y Vite",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "setup": "npm install && node scripts/setup.js",
    "dev": "npm run build && npm run server:dev",
    "dev:proxy": "concurrently \"npm run server:proxy\" \"npm run client:dev\"",
    "server:dev": "nodemon server/index.js",
    "server:proxy": "PROXY_MODE=true nodemon server/index.js",
    "client:dev": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "cors": "^2.8.5",
    "http-proxy-middleware": "^2.0.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
